# Copy this file to ".env" (same folder) and fill in your keys. ".env" is git-ignored.
chat_api=
groq_key=
gemini_key=
mistral_key=
deepseek_key=
# Grok via Oracle OCI. A value starting with @ is read from that file (path relative to this folder).
OCI_KEY=@oci_api_key.pem
OCI_CONFIG=@oci_config
COMPARTMENT_ID=
MODEL_ID=
