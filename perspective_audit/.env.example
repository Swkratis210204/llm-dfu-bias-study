# Copy this file to ".env" and fill in your keys. ".env" must not be committed.
# The names are the ones the models look for (ModelConfig.api_key_env).
chat_api=
gemini_key=
mistral_key=
deepseek_key=
# Llama runs locally through Ollama and needs no key (ollama pull llama3:8b).

# Grok via Oracle OCI. A value starting with @ is read from that file (path relative to this file).
# OCI_KEY and OCI_CONFIG may span several lines; a blank line ends them.
OCI_KEY=
OCI_CONFIG=
COMPARTMENT_ID=
MODEL_ID=

# --- optional ---------------------------------------------------------------------------------
# Which models ModelHub.from_env() builds (default: chatgpt,llama,gemini,mistral,deepseek; grok is off):
# PERSPECTIVE_AUDIT_MODELS=chatgpt,llama,gemini,mistral,deepseek
# Per-model overrides, name in capitals: <NAME>_MODEL, <NAME>_BASE_URL, <NAME>_API_KEY_ENV, <NAME>_TEMPERATURE, <NAME>_MAX_TOKENS
# LLAMA_BASE_URL=http://localhost:11434/v1
# MISTRAL_MODEL=open-mistral-7b
